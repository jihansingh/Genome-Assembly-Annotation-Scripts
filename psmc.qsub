#!/bin/bash
#PBS -l nodes=1:ppn=28
#PBS -l walltime=720:00:00
#PBS -q long
#PBS -o stdout.psmc
#PBS -e stderr.psmc
#PBS -k oe
#PBS -m ae
#PBS -M u21465186@tuks.co.za

cd $PBS_O_WORKDIR

# ---------------------------
# MODULES
# ---------------------------
module load samtools-1.18
module load bcftools-1.18
module load psmc
module load seqtk
module load minimap2

#Mapping
echo "Start Mapping"
mkdir minimap2_racon

minimap2 -ax map-ont -t 28 \
        "/nlustre/users/jsingh/ficus_salicifolia/racon_hifiasm/racon_polish3.fasta" \
        "/nlustre/users/jsingh/ficus_salicifolia/raw_reads/ficus_salicifolia.fq" \
        > /nlustre/users/jsingh/ficus_salicifolia/minimap2_racon/minimap2_racon.sam
# ---------------------------
# PATHS / SETTINGS
# ---------------------------
ASSEMBLY="/nlustre/users/jsingh/ficus_salicifolia/racon_hifiasm/racon_polish3.fasta"
SAM_FILE="/nlustre/users/jsingh/ficus_salicifolia/minimap2_racon/minimap2_racon.sam"
SAMPLE_ID=F_salicifolia
PSMC_DIR="/nlustre/users/jsingh/ficus_salicifolia/psmc_results"
BCFTOOLS_DIR="/nlustre/users/jsingh/ficus_salicifolia/bcftools"

# Create directories
mkdir -p $PSMC_DIR/psmcfa_files
mkdir -p $PSMC_DIR/psmc_out/$SAMPLE_ID
mkdir -p $PSMC_DIR/bootstrap/$SAMPLE_ID
mkdir -p $PSMC_DIR/plots/$SAMPLE_ID
mkdir -p $BCFTOOLS_DIR

# ---------------------------
# 1) Convert SAM -> BAM, sort
# ---------------------------
echo "Converting SAM -> BAM and sorting..."
samtools view -@ 28 -bS $SAM_FILE | \
samtools sort -@ 28 -m 2G \
  -T $BCFTOOLS_DIR/sort_tmp \
  -o $BCFTOOLS_DIR/${SAMPLE_ID}_sorted.bam

# Index
samtools index $BCFTOOLS_DIR/${SAMPLE_ID}_sorted.bam

# ---------------------------
# 2) MAPQ filter >=20
# ---------------------------
echo "Filtering BAM for MAPQ >=20..."
samtools view -b -q 20 \
  $BCFTOOLS_DIR/${SAMPLE_ID}_sorted.bam \
  > $BCFTOOLS_DIR/${SAMPLE_ID}_filtered.bam
samtools index $BCFTOOLS_DIR/${SAMPLE_ID}_filtered.bam

# ---------------------------
# 3) Generate diploid consensus FASTQ
# ---------------------------
# Average coverage = 78X
# min depth = ~1/3 average (26), max depth = ~2x average (156)
echo "Generating diploid consensus FASTQ..."
bcftools mpileup -C50 -Ou -f $ASSEMBLY \
  $BCFTOOLS_DIR/${SAMPLE_ID}_filtered.bam \
  | bcftools call -c \
  | vcfutils.pl vcf2fq -d 26 -D 156 \
  | gzip > $BCFTOOLS_DIR/${SAMPLE_ID}_diploid.fq.gz

# ---------------------------
# 4) Convert to PSMCFA
# ---------------------------
echo "Converting FASTQ -> PSMCFA..."
fq2psmcfa -q20 $BCFTOOLS_DIR/${SAMPLE_ID}_diploid.fq.gz \
  > $PSMC_DIR/psmcfa_files/${SAMPLE_ID}.psmcfa

# ---------------------------
# 5) Run PSMC
# ---------------------------
echo "Running PSMC..."
psmc -N30 -t5 -r5 -p "4+25*2+4+6" \
  -o $PSMC_DIR/psmc_out/$SAMPLE_ID/${SAMPLE_ID}.psmc \
  $PSMC_DIR/psmcfa_files/${SAMPLE_ID}.psmcfa

# ------------------------------------------------------------
# STEP 1: Split psmcfa for bootstrapping
# ------------------------------------------------------------

echo "[$(date)] Splitting psmcfa..."

splitfa "${PSMCFA}" > "${BOOTSTRAP_DIR}/${SAMPLE_ID}_split.psmcfa"

echo "[$(date)] Split psmcfa written to: ${BOOTSTRAP_DIR}/${SAMPLE_ID}_split.psmcfa"

# ------------------------------------------------------------
# STEP 2: Run 100 bootstrap replicates (parallelised)
# ------------------------------------------------------------

echo "[$(date)] Running 100 bootstrap replicates (${THREADS} threads)..."

seq 1 100 | parallel -j "${THREADS}" \
    "psmc ${PSMC_PARAMS} \
        -b \
        -o ${BOOTSTRAP_DIR}/bootstrap_{}.psmc \
        ${BOOTSTRAP_DIR}/${SAMPLE_ID}_split.psmcfa"

echo "[$(date)] Bootstrap runs complete"

# ------------------------------------------------------------
# STEP 3: Combine main run + bootstraps and plot
# ------------------------------------------------------------

echo "[$(date)] Combining main PSMC output with bootstraps..."

cat "${PSMC_OUT}" \
    "${BOOTSTRAP_DIR}"/bootstrap_*.psmc \
    > "${PSMC_DIR}/${SAMPLE_ID}_combined.psmc"

echo "[$(date)] Generating plot..."

psmc_plot.pl \
    -u "${MUTATION_RATE}" \
    -g "${GENERATION_TIME}" \
    -p \
    "${PLOT_PREFIX}" \
    "${PSMC_DIR}/${SAMPLE_ID}_combined.psmc"

echo "[$(date)] Plot written to: ${PLOT_PREFIX}.pdf and ${PLOT_PREFIX}.eps"
echo "[$(date)] Done."


