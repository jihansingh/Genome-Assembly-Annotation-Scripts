#!/bin/bash
#PBS -l nodes=1:ppn=24
#PBS -l walltime=720:00:00
#PBS -q long
#PBS -o stdout.psmc
#PBS -e stderr.psmc
#PBS -k oe
#PBS -m ae
#PBS -M u21465186@tuks.co.za

cd $PBS_O_WORKDIR

# ---------------------------
# MODULES
# ---------------------------
module load samtools-1.18
module load bcftools-1.18
module load psmc
module load seqtk
module load minimap2

#Mapping
echo "Start Mapping"
mkdir minimap2_racon

minimap2 -ax map-ont -t 24 \
        "/nlustre/users/jsingh/ficus_craterostoma/racon_hifiasm/racon_polish3.fasta" \
        "/nlustre/users/jsingh/ficus_craterostoma/raw_reads/jihan-fig1.fq.gz" \
        > /nlustre/users/jsingh/ficus_craterostoma/minimap2_racon/minimap2_racon.sam
# ---------------------------
# PATHS / SETTINGS
# ---------------------------
ASSEMBLY="/nlustre/users/jsingh/ficus_craterostoma/racon_hifiasm/racon_polish3.fasta"
SAM_FILE="/nlustre/users/jsingh/ficus_craterostoma/minimap2_racon/minimap2_racon.sam"
SAMPLE_ID=F_craterostoma
PSMC_DIR="/nlustre/users/jsingh/ficus_craterostoma/psmc_results"
BCFTOOLS_DIR="/nlustre/users/jsingh/ficus_craterostoma/bcftools"

# Create directories
mkdir -p $PSMC_DIR/psmcfa_files
mkdir -p $PSMC_DIR/psmc_out/$SAMPLE_ID
mkdir -p $PSMC_DIR/bootstrap/$SAMPLE_ID
mkdir -p $PSMC_DIR/plots/$SAMPLE_ID
mkdir -p $BCFTOOLS_DIR

# ---------------------------
# 1) Convert SAM -> BAM, sort
# ---------------------------
echo "Converting SAM -> BAM and sorting..."
samtools view -@ 24 -bS $SAM_FILE | \
samtools sort -@ 24 -m 2G \
  -T $BCFTOOLS_DIR/sort_tmp \
  -o $BCFTOOLS_DIR/${SAMPLE_ID}_sorted.bam

# Index
samtools index $BCFTOOLS_DIR/${SAMPLE_ID}_sorted.bam

# ---------------------------
# 2) MAPQ filter >=20
# ---------------------------
echo "Filtering BAM for MAPQ >=20..."
samtools view -b -q 20 \
  $BCFTOOLS_DIR/${SAMPLE_ID}_sorted.bam \
  > $BCFTOOLS_DIR/${SAMPLE_ID}_filtered.bam
samtools index $BCFTOOLS_DIR/${SAMPLE_ID}_filtered.bam

# ---------------------------
# 3) Generate diploid consensus FASTQ
# ---------------------------
# Average coverage = 111X
# min depth = ~1/3 average (37), max depth = ~2x average (222)
echo "Generating diploid consensus FASTQ..."
bcftools mpileup -C50 -Ou -f $ASSEMBLY \
  $BCFTOOLS_DIR/${SAMPLE_ID}_filtered.bam \
  | bcftools call -c \
  | vcfutils.pl vcf2fq -d 37 -D 222 \
  | gzip > $BCFTOOLS_DIR/${SAMPLE_ID}_diploid.fq.gz

# ---------------------------
# 4) Convert to PSMCFA
# ---------------------------
echo "Converting FASTQ -> PSMCFA..."
fq2psmcfa -q20 $BCFTOOLS_DIR/${SAMPLE_ID}_diploid.fq.gz \
  > $PSMC_DIR/psmcfa_files/${SAMPLE_ID}.psmcfa

# ---------------------------
# 5) Run PSMC
# ---------------------------
echo "Running PSMC..."
psmc -N30 -t5 -r5 -p "4+25*2+4+6" \
  -o $PSMC_DIR/psmc_out/$SAMPLE_ID/${SAMPLE_ID}.psmc \
  $PSMC_DIR/psmcfa_files/${SAMPLE_ID}.psmcfa

# ---------------------------
# 6) Bootstrap replicates (parallelised)
# ---------------------------
echo "Running 100 bootstrap replicates..."
splitfa $PSMC_DIR/psmcfa_files/${SAMPLE_ID}.psmcfa \
  > $PSMC_DIR/bootstrap/$SAMPLE_ID/${SAMPLE_ID}.split.psmcfa

seq 1 100 | parallel -j 24 \
  "seqtk sample -s{} $PSMC_DIR/bootstrap/$SAMPLE_ID/${SAMPLE_ID}.split.psmcfa 100 \
  > $PSMC_DIR/bootstrap/$SAMPLE_ID/${SAMPLE_ID}.bootstrap.{}.psmcfa && \
  psmc -N30 -t5 -r5 -p \"4+25*2+4+6\" \
  -o $PSMC_DIR/bootstrap/$SAMPLE_ID/${SAMPLE_ID}.bootstrap.{}.psmc \
  $PSMC_DIR/bootstrap/$SAMPLE_ID/${SAMPLE_ID}.bootstrap.{}.psmcfa"

# ---------------------------
# 7) Plotting
# ---------------------------
echo "Plotting PSMC results..."
GEN_TIME=7
MU=1.75e-8

psmc_plot.pl -g $GEN_TIME -u $MU \
  $PSMC_DIR/plots/$SAMPLE_ID/${SAMPLE_ID}_plot \
  $PSMC_DIR/psmc_out/$SAMPLE_ID/${SAMPLE_ID}.psmc \
  $PSMC_DIR/bootstrap/$SAMPLE_ID/${SAMPLE_ID}.bootstrap.*.psmc

echo "PSMC workflow complete for $SAMPLE_ID."
date
