#!/bin/bash
#PBS -l nodes=1:ppn=24
#PBS -l walltime=24:00:00
#PBS -q normal
#PBS -o stdout.psmc50
#PBS -e stderr.psmc50
#PBS -k oe
#PBS -m ae
#PBS -M u21465186@tuks.co.za

module load psmc

SAMPLE_ID="F_craterostoma"
PSMC_DIR="/nlustre/users/jsingh/ficus_craterostoma/psmc_results"

PSMCFA="${PSMC_DIR}/psmcfa_files/${SAMPLE_ID}.psmcfa"
PSMC_OUT="/nlustre/users/jsingh/ficus_craterostoma/psmc_results/psmc_out/F_craterostoma/F_craterostoma.psmc"
BOOTSTRAP_DIR="${PSMC_DIR}/bootstraps"
PLOT_PREFIX="${PSMC_DIR}/plots/${SAMPLE_ID}_50_psmc"

PSMC_PARAMS="-N30 -t5 -r5 -p 4+25*2+4+6"
GENERATION_TIME=50
MUTATION_RATE=1.75e-8

THREADS=24

cat "${PSMC_OUT}" \
    "${BOOTSTRAP_DIR}"/bootstrap_*.psmc \
    > "${PSMC_DIR}/${SAMPLE_ID}_combined_50.psmc"

echo "[$(date)] Generating plot..."

psmc_plot.pl \
    -u "${MUTATION_RATE}" \
    -g "${GENERATION_TIME}" \
    -p \
    "${PLOT_PREFIX}" \
    "${PSMC_DIR}/${SAMPLE_ID}_combined_50.psmc"

echo "[$(date)] Plot written to: ${PLOT_PREFIX}.pdf and ${PLOT_PREFIX}.eps"
echo "[$(date)] Done."

