#!/bin/bash
#PBS -N augustus_train
#PBS -l nodes=1:ppn=24
#PBS -l walltime=720:00:00
#PBS -q long
#PBS -o augustus_train.stdout
#PBS -e augustus_train.stderr
#PBS -k oe
#PBS -m ae
#PBS -M u21465186@tuks.co.za

# =============================
# CHANGE TO WORKING DIRECTORY
# =============================
cd $PBS_O_WORKDIR
echo "Starting AUGUSTUS training in project-specific directory"
date

# =============================
# SETTINGS
# =============================
SPECIES=ficus_craterostoma
GFF="/nlustre/users/jsingh/ficus_craterostoma/hifiasm_annotation.maker.output/hifiasm_annotation.all.maker.gff"
GENOME="/nlustre/users/jsingh/ficus_craterostoma/racon_hifiasm/racon_polish3.fasta"
THREADS=24

# =============================
# LOAD MODULES
# =============================
module load augustus-3.5.0
module load maker-2.31.10

# =============================
# 1) CLEAN GFF (remove embedded FASTA)
# =============================
echo "Cleaning GFF to remove embedded FASTA sequences..."
sed -n '/^>/q;p' ${GFF} > ${SPECIES}.clean.gff

# =============================
# 2) CONVERT CLEAN GFF -> GENBANK
# =============================
echo "Converting MAKER GFF -> GenBank format..."
gff2gbSmallDNA.pl ${SPECIES}.clean.gff ${GENOME} 2000 ${SPECIES}.gb

# =============================
# 1) CLEAN GFF (remove embedded FASTA)
# =============================
echo "Cleaning GFF to remove embedded FASTA sequences..."
sed -n '/^>/q;p' ${GFF} > ${SPECIES}.clean.gff

# =============================
# 2) CONVERT CLEAN GFF -> GENBANK
# =============================
echo "Converting MAKER GFF -> GenBank format..."
gff2gbSmallDNA.pl ${SPECIES}.clean.gff ${GENOME} 2000 ${SPECIES}.gb

# =============================
# 3) SPLIT INTO TRAIN / TEST
# =============================
echo "Splitting into training and test sets..."
randomSplit.pl ${SPECIES}.gb 100
# Produces:
#   ${SPECIES}.gb.train
#   ${SPECIES}.gb.test

# =============================
# 4) CREATE NEW SPECIES PARAMETERS
# =============================
echo "Creating project-specific species parameters..."
new_species.pl --species=${SPECIES}

# =============================
# 5) INITIAL TRAINING
# =============================
echo "Running initial etraining..."
etraining --species=${SPECIES} ${SPECIES}.gb.train

# =============================
# 6) PARAMETER OPTIMIZATION
# =============================
echo "Running optimize_augustus.pl (may take hours)..."
optimize_augustus.pl --species=${SPECIES} ${SPECIES}.gb.train --cpus=${THREADS}

# Re-run etraining after optimization
etraining --species=${SPECIES} ${SPECIES}.gb.train

# =============================
# 7) TEST PREDICTION ACCURACY
# =============================
echo "Evaluating predictions on test set..."
# Convert GB test set to FASTA for AUGUSTUS prediction

augustus --species=${SPECIES} ${SPECIES}.test.gb

echo "AUGUSTUS training complete!"
date
