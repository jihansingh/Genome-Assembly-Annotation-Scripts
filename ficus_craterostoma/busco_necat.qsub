#!/bin/bash
#PBS -l nodes=1:ppn=24
#PBS -l walltime=720:00:00
#PBS -q bigmem
#PBS -o stdout.busco_necat 
#PBS -e stderr.busco_necat
#PBS -k oe
#PBS -m ae
#PBS -M u21465186@tuks.co.za

cd $PBS_O_WORKDIR

module load busco-5.7.1

busco \
 -i /nlustre/users/jsingh/ficus_craterostoma/racon_necat/racon_polish3.fasta \
 -l /nlustre/users/jsingh/ficus_craterostoma/busco_downloads/lineages/embryophyta_odb10 \
 -o busco_necat \
 -m genome \
 -c 24 \
 --offline
