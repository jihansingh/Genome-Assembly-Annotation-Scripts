#!/bin/bash
#PBS -l nodes=1:ppn=24
#PBS -l walltime=8:00:00
#PBS -q normal
#PBS -o stdout.nanoqc 
#PBS -e stderr.nanoqc
#PBS -k oe
#PBS -m ae
