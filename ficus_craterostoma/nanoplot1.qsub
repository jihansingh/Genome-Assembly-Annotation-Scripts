cd $PBS_O_WORKDIR

module load nanoplot
NanoPlot \
  --fastq /nlustre/users/jsingh/ficus_craterostoma/raw_reads/jihan-fig1.fq \
  -o nanoplot1_out \
  --plots hex dot \
  --threads 24 \
  --loglength \
  --N50 \
  --title "Ficus Craterostoma Read QC"


